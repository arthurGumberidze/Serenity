@import url("unity-theme://default");

/*
 * UI02 Black and Gold runtime theme. The final overrides at the end of this file are the
 * authoritative token projection. All selectors are presentation-only and preserve stable
 * element names used by automated navigation and command paths.
 */

.serenity-root {
    color: rgb(243, 234, 216);
    font-size: 14px;
}

/*
 * UI02 authoritative Black and Gold token projection.
 * Warm near-black carries structure; old gold is reserved for focus, selection and primary actions.
 */
.serenity-root {
    color: rgb(238, 231, 216);
    font-size: 14px;
}

.serenity-main-menu,
.serenity-menu-atmosphere {
    background-color: rgb(13, 12, 10);
}

.serenity-surface,
.serenity-menu-shell,
.serenity-gameplay .serenity-surface,
.serenity-gameplay .serenity-card,
.serenity-gameplay .serenity-button,
.serenity-gameplay .serenity-foldout > .unity-foldout__toggle {
    color: rgb(238, 231, 216);
    background-color: rgba(23, 21, 17, 0.96);
    border-left-color: rgba(184, 154, 91, 0.46);
    border-right-color: rgba(184, 154, 91, 0.26);
    border-top-color: rgba(184, 154, 91, 0.26);
    border-bottom-color: rgba(184, 154, 91, 0.26);
}

.serenity-surface-raised,
.serenity-gameplay .serenity-surface-raised,
.serenity-modal {
    background-color: rgba(33, 30, 24, 0.98);
}

.serenity-card {
    background-color: rgba(42, 38, 30, 0.96);
    border-left-color: rgba(184, 154, 91, 0.72);
}

.serenity-card.is-selected,
.serenity-card-action.is-selected {
    color: rgb(238, 231, 216);
    background-color: rgb(48, 43, 34);
    border-left-color: rgb(210, 184, 117);
    border-right-color: rgba(210, 184, 117, 0.7);
    border-top-color: rgba(210, 184, 117, 0.7);
    border-bottom-color: rgba(210, 184, 117, 0.7);
}

.serenity-button {
    min-height: 40px;
    color: rgb(238, 231, 216);
    background-color: rgb(42, 38, 30);
    border-left-color: rgba(184, 154, 91, 0.42);
    border-right-color: rgba(184, 154, 91, 0.42);
    border-top-color: rgba(184, 154, 91, 0.42);
    border-bottom-color: rgba(184, 154, 91, 0.42);
}

.serenity-button:hover,
.serenity-gameplay .serenity-button:hover {
    color: rgb(238, 231, 216);
    background-color: rgb(48, 43, 34);
    border-left-color: rgb(210, 184, 117);
    border-right-color: rgb(210, 184, 117);
    border-top-color: rgb(210, 184, 117);
    border-bottom-color: rgb(210, 184, 117);
}

.serenity-button:active {
    color: rgb(238, 231, 216);
    background-color: rgb(58, 49, 31);
}

.serenity-button:focus {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(210, 184, 117);
    border-right-color: rgb(210, 184, 117);
    border-top-color: rgb(210, 184, 117);
    border-bottom-color: rgb(210, 184, 117);
}

.serenity-button:disabled {
    color: rgba(184, 174, 155, 0.52);
    background-color: rgba(25, 23, 19, 0.9);
    border-left-color: rgba(184, 174, 155, 0.16);
    border-right-color: rgba(184, 174, 155, 0.16);
    border-top-color: rgba(184, 174, 155, 0.16);
    border-bottom-color: rgba(184, 174, 155, 0.16);
}

.serenity-button-primary,
.serenity-gameplay .serenity-button-primary,
.serenity-gameplay .serenity-time-button.is-selected,
.serenity-gameplay #pause-button.is-selected {
    color: rgb(23, 19, 13);
    background-color: rgb(184, 154, 91);
}

.serenity-button-primary:hover {
    color: rgb(23, 19, 13);
    background-color: rgb(210, 184, 117);
}

.serenity-title {
    color: rgb(210, 184, 117);
    font-size: 24px;
    letter-spacing: 0.35px;
}

.serenity-section-title,
.serenity-body,
.serenity-field,
.serenity-field .unity-base-text-field__input,
.serenity-field .unity-popup-field__input,
.serenity-field .unity-slider__input {
    color: rgb(238, 231, 216);
}

.serenity-muted,
.serenity-field .unity-base-field__label {
    color: rgb(184, 174, 155);
}

.serenity-field .unity-base-text-field__input,
.serenity-field .unity-popup-field__input,
.serenity-field .unity-slider__input,
.serenity-root .unity-scroller,
.serenity-root .unity-scroller .unity-base-slider__tracker {
    background-color: rgb(13, 12, 10);
}

.serenity-top-hud,
.serenity-resource-drawer,
.serenity-inspector,
.serenity-notifications,
.serenity-main-panel.is-build-palette,
.serenity-bottom-dock {
    background-color: rgba(23, 21, 17, 0.96);
    border-color: rgba(184, 154, 91, 0.56);
}

.serenity-resource-chip,
.serenity-time-cluster,
.serenity-resident-card,
.serenity-build-card,
.serenity-build-category {
    background-color: rgba(42, 38, 30, 0.94);
}

.serenity-icon,
.serenity-icon-button {
    -unity-background-image-tint-color: rgb(210, 184, 117);
}

.serenity-bottom-navigation {
    background-color: rgba(15, 14, 12, 0.98);
    border-top-width: 1px;
    border-top-color: rgba(210, 184, 117, 0.72);
    overflow: hidden;
}

.serenity-bottom-navigation .unity-scroll-view__content-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.serenity-gameplay .serenity-bottom-navigation .serenity-nav-button {
    width: 96px;
    min-width: 82px;
    height: 64px;
    min-height: 64px;
    margin-left: 2px;
    margin-right: 2px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 31px;
    padding-bottom: 2px;
    font-size: 11px;
    white-space: normal;
    -unity-text-align: lower-center;
    background-size: 28px 28px;
    background-position: 50% 3px;
    border-left-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
}

.serenity-gameplay .serenity-bottom-navigation .serenity-nav-button.is-selected {
    color: rgb(238, 231, 216);
    background-color: rgb(48, 43, 34);
    border-left-color: transparent;
    border-bottom-color: rgb(210, 184, 117);
}

.serenity-navigation-divider {
    width: 1px;
    height: 44px;
    margin-left: 5px;
    margin-right: 5px;
    background-color: rgba(184, 154, 91, 0.32);
}

.serenity-navigation-utility {
    width: 42px;
    min-width: 42px;
    height: 42px;
    margin-left: 2px;
    margin-right: 2px;
    padding-left: 2px;
    padding-right: 2px;
    font-size: 18px;
}

.serenity-badge {
    min-height: 24px;
    padding-left: 8px;
    padding-right: 8px;
    border-left-width: 2px;
    border-left-color: rgb(102, 121, 133);
    background-color: rgba(42, 38, 30, 0.94);
    color: rgb(238, 231, 216);
}

.serenity-badge.is-success { border-left-color: rgb(113, 138, 114); }
.serenity-badge.is-warning { border-left-color: rgb(167, 128, 85); }
.serenity-badge.is-danger { border-left-color: rgb(164, 95, 80); }

.serenity-attention-message {
    border-left-color: rgb(102, 121, 133);
}

.serenity-compact .serenity-gameplay .serenity-bottom-navigation .serenity-nav-button,
.serenity-compact .serenity-bottom-navigation .serenity-nav-button {
    width: 84px;
    min-width: 76px;
    font-size: 10px;
}

.serenity-main-menu {
    background-color: rgb(17, 23, 16);
}

.serenity-menu-atmosphere {
    background-color: rgb(14, 21, 13);
    border-left-width: 18px;
    border-right-width: 18px;
    border-top-width: 18px;
    border-bottom-width: 18px;
    border-left-color: rgba(87, 107, 65, 0.2);
    border-right-color: rgba(87, 107, 65, 0.2);
    border-top-color: rgba(201, 155, 74, 0.1);
    border-bottom-color: rgba(201, 155, 74, 0.1);
}

.serenity-surface {
    background-color: rgba(27, 36, 25, 0.97);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(201, 155, 74, 0.28);
    border-right-color: rgba(201, 155, 74, 0.28);
    border-top-color: rgba(201, 155, 74, 0.28);
    border-bottom-color: rgba(201, 155, 74, 0.28);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.serenity-surface-raised {
    background-color: rgba(37, 48, 32, 0.98);
    border-left-color: rgba(225, 188, 114, 0.48);
    border-right-color: rgba(225, 188, 114, 0.48);
    border-top-color: rgba(225, 188, 114, 0.48);
    border-bottom-color: rgba(225, 188, 114, 0.48);
}

.serenity-card {
    background-color: rgba(48, 58, 40, 0.86);
    border-left-width: 3px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(201, 155, 74, 0.7);
    border-right-color: rgba(231, 219, 192, 0.12);
    border-top-color: rgba(231, 219, 192, 0.12);
    border-bottom-color: rgba(231, 219, 192, 0.12);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-top: 4px;
    margin-bottom: 7px;
}

.serenity-card.is-selected {
    background-color: rgba(69, 78, 51, 0.98);
    border-left-color: rgb(225, 188, 114);
    border-right-color: rgba(225, 188, 114, 0.72);
    border-top-color: rgba(225, 188, 114, 0.72);
    border-bottom-color: rgba(225, 188, 114, 0.72);
}

.serenity-button {
    min-height: 34px;
    color: rgb(243, 234, 216);
    background-color: rgb(47, 58, 40);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(225, 188, 114, 0.42);
    border-right-color: rgba(225, 188, 114, 0.42);
    border-top-color: rgba(225, 188, 114, 0.42);
    border-bottom-color: rgba(225, 188, 114, 0.42);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    padding-left: 12px;
    padding-right: 12px;
    white-space: normal;
    transition-property: background-color, border-left-color, border-right-color, border-top-color, border-bottom-color, color;
    transition-duration: 0.12s;
}

.serenity-button:hover {
    color: rgb(255, 248, 232);
    background-color: rgb(62, 75, 50);
    border-left-color: rgb(225, 188, 114);
    border-right-color: rgb(225, 188, 114);
    border-top-color: rgb(225, 188, 114);
    border-bottom-color: rgb(225, 188, 114);
}

.serenity-button:active {
    color: rgb(255, 255, 255);
    background-color: rgb(91, 74, 42);
    border-left-color: rgb(255, 218, 145);
    border-right-color: rgb(255, 218, 145);
    border-top-color: rgb(255, 218, 145);
    border-bottom-color: rgb(255, 218, 145);
}

.serenity-button:focus {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(255, 218, 145);
    border-right-color: rgb(255, 218, 145);
    border-top-color: rgb(255, 218, 145);
    border-bottom-color: rgb(255, 218, 145);
}

.serenity-button:disabled {
    color: rgba(243, 234, 216, 0.44);
    background-color: rgba(35, 40, 32, 0.82);
    border-left-color: rgba(185, 181, 165, 0.18);
    border-right-color: rgba(185, 181, 165, 0.18);
    border-top-color: rgba(185, 181, 165, 0.18);
    border-bottom-color: rgba(185, 181, 165, 0.18);
}

.serenity-button-primary {
    color: rgb(26, 28, 20);
    background-color: rgb(201, 155, 74);
    -unity-font-style: bold;
}

.serenity-button-primary:hover {
    color: rgb(20, 22, 16);
    background-color: rgb(225, 188, 114);
}

.serenity-nav-button {
    min-height: 40px;
    margin-top: 2px;
    margin-bottom: 2px;
    -unity-text-align: middle-left;
    border-left-width: 3px;
    border-left-color: transparent;
    background-color: rgba(36, 45, 31, 0.76);
}

.serenity-nav-button.is-selected {
    color: rgb(255, 246, 225);
    background-color: rgb(65, 75, 50);
    border-left-color: rgb(225, 188, 114);
}

.serenity-card-action {
    min-height: 46px;
    -unity-text-align: middle-left;
    border-left-width: 3px;
    border-left-color: rgba(201, 155, 74, 0.64);
    background-color: rgba(48, 58, 40, 0.9);
}

.serenity-card-action.is-selected {
    color: rgb(255, 248, 232);
    background-color: rgb(69, 78, 51);
    border-left-color: rgb(225, 188, 114);
}

.serenity-time-button {
    min-width: 42px;
    padding-left: 7px;
    padding-right: 7px;
}

.serenity-time-button.is-selected,
#pause-button.is-selected {
    color: rgb(25, 28, 20);
    background-color: rgb(225, 188, 114);
    -unity-font-style: bold;
}

.serenity-title {
    color: rgb(225, 188, 114);
    font-size: 23px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 10px;
}

.serenity-section-title {
    color: rgb(243, 234, 216);
    font-size: 15px;
    -unity-font-style: bold;
    white-space: normal;
    margin-top: 10px;
    margin-bottom: 5px;
}

.serenity-body {
    color: rgb(243, 234, 216);
    white-space: normal;
    margin-bottom: 4px;
}

.serenity-muted {
    color: rgb(185, 181, 165);
    font-size: 12px;
    white-space: normal;
    margin-bottom: 5px;
}

.serenity-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.serenity-chip {
    min-height: 44px;
    background-color: rgba(45, 56, 39, 0.9);
    border-bottom-width: 2px;
    border-bottom-color: rgba(201, 155, 74, 0.48);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    margin-right: 6px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.serenity-field {
    color: rgb(243, 234, 216);
    min-height: 38px;
    margin-top: 5px;
    margin-bottom: 7px;
    white-space: normal;
}

.serenity-field .unity-base-field__label {
    color: rgb(216, 207, 187);
    min-width: 145px;
    white-space: normal;
}

.serenity-field .unity-base-text-field__input,
.serenity-field .unity-popup-field__input,
.serenity-field .unity-slider__input {
    color: rgb(243, 234, 216);
    background-color: rgb(22, 29, 20);
    border-left-color: rgba(225, 188, 114, 0.52);
    border-right-color: rgba(225, 188, 114, 0.52);
    border-top-color: rgba(225, 188, 114, 0.52);
    border-bottom-color: rgba(225, 188, 114, 0.52);
}

.serenity-root .unity-scroller {
    background-color: rgb(22, 29, 20);
    min-width: 14px;
    min-height: 14px;
}

.serenity-root .unity-scroller__slider {
    background-color: rgb(74, 84, 57);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(225, 188, 114, 0.55);
    border-right-color: rgba(225, 188, 114, 0.55);
    border-top-color: rgba(225, 188, 114, 0.55);
    border-bottom-color: rgba(225, 188, 114, 0.55);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.serenity-root .unity-scroller__slider:hover {
    background-color: rgb(96, 105, 70);
}

.serenity-root .unity-scroller .unity-base-slider__tracker {
    background-color: rgb(22, 29, 20);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.serenity-root .unity-scroller .unity-base-slider__dragger {
    background-color: rgb(74, 84, 57);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(201, 155, 74);
    border-right-color: rgb(201, 155, 74);
    border-top-color: rgb(201, 155, 74);
    border-bottom-color: rgb(201, 155, 74);
}

.serenity-root .unity-scroller .unity-base-slider__dragger-border {
    background-color: transparent;
}

.serenity-root .unity-scroller__low-button,
.serenity-root .unity-scroller__high-button {
    color: rgb(225, 188, 114);
    background-color: rgb(37, 48, 32);
    border-left-color: rgba(225, 188, 114, 0.38);
    border-right-color: rgba(225, 188, 114, 0.38);
    border-top-color: rgba(225, 188, 114, 0.38);
    border-bottom-color: rgba(225, 188, 114, 0.38);
}

.serenity-modal {
    background-color: rgb(30, 36, 25);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(225, 188, 114);
    border-right-color: rgb(225, 188, 114);
    border-top-color: rgb(225, 188, 114);
    border-bottom-color: rgb(225, 188, 114);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.serenity-foldout {
    margin-top: 6px;
    margin-bottom: 6px;
}

.serenity-foldout > .unity-foldout__toggle {
    color: rgb(225, 188, 114);
    background-color: rgba(37, 48, 32, 0.92);
    min-height: 36px;
    -unity-font-style: bold;
}

.serenity-menu-shell {
    background-color: rgba(27, 36, 25, 0.97);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(225, 188, 114, 0.35);
    border-right-color: rgba(225, 188, 114, 0.35);
    border-top-color: rgba(225, 188, 114, 0.35);
    border-bottom-color: rgba(225, 188, 114, 0.35);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.serenity-menu-button {
    width: 100%;
    -unity-text-align: middle-center;
    letter-spacing: 0.4px;
}

.serenity-editor-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.serenity-editor-column {
    min-width: 410px;
    flex-grow: 1;
    margin-left: 5px;
    margin-right: 5px;
}

.serenity-preview {
    background-color: rgb(13, 18, 13);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(225, 188, 114, 0.3);
    border-right-color: rgba(225, 188, 114, 0.3);
    border-top-color: rgba(225, 188, 114, 0.3);
    border-bottom-color: rgba(225, 188, 114, 0.3);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.serenity-status {
    color: rgb(225, 188, 114);
    background-color: rgba(17, 23, 16, 0.88);
    border-top-width: 1px;
    border-top-color: rgba(225, 188, 114, 0.28);
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 12px;
    padding-right: 12px;
    white-space: normal;
}

.serenity-compact {
    font-size: 13px;
}

.serenity-compact .serenity-chip {
    font-size: 12px;
    padding-left: 7px;
    padding-right: 7px;
}

.serenity-compact .serenity-button {
    padding-left: 9px;
    padding-right: 9px;
}

#tps-hud {
    overflow: hidden;
}

#tps-hud .unity-label {
    white-space: normal;
    -unity-text-align: middle-center;
}

/*
 * P10.9 modern strategy HUD. These late overrides intentionally keep the stable UXML names
 * and interaction contracts while replacing the former moss-heavy presentation.
 */
.serenity-gameplay {
    color: rgb(241, 238, 232);
}

.serenity-gameplay .serenity-surface,
.serenity-gameplay .serenity-card,
.serenity-gameplay .serenity-button,
.serenity-gameplay .serenity-foldout > .unity-foldout__toggle {
    background-color: rgba(29, 36, 43, 0.96);
    border-left-color: rgba(213, 166, 107, 0.46);
    border-right-color: rgba(213, 166, 107, 0.3);
    border-top-color: rgba(213, 166, 107, 0.3);
    border-bottom-color: rgba(213, 166, 107, 0.3);
}

.serenity-gameplay .serenity-surface-raised {
    background-color: rgba(41, 51, 61, 0.97);
}

.serenity-gameplay .serenity-button:hover {
    color: rgb(255, 250, 242);
    background-color: rgb(51, 65, 75);
    border-left-color: rgb(232, 197, 142);
    border-right-color: rgb(232, 197, 142);
    border-top-color: rgb(232, 197, 142);
    border-bottom-color: rgb(232, 197, 142);
}

.serenity-gameplay .serenity-button-primary,
.serenity-gameplay .serenity-time-button.is-selected,
.serenity-gameplay #pause-button.is-selected {
    color: rgb(23, 28, 33);
    background-color: rgb(213, 166, 107);
}

.serenity-top-hud {
    background-color: rgba(20, 27, 33, 0.95);
    border-bottom-width: 2px;
    border-bottom-color: rgba(213, 166, 107, 0.72);
}

.serenity-resource-strip {
    flex-grow: 1;
    overflow: hidden;
}

.serenity-population-chip {
    color: rgb(241, 238, 232);
    -unity-font-style: bold;
    margin-right: 9px;
    min-width: 74px;
}

.serenity-icon {
    width: 25px;
    height: 25px;
    margin-left: 3px;
    margin-right: 3px;
}

.serenity-resource-chip {
    min-height: 38px;
    min-width: 63px;
    padding-left: 5px;
    padding-right: 7px;
    margin-right: 3px;
    background-color: rgba(41, 51, 61, 0.7);
    border-bottom-width: 1px;
    border-bottom-color: rgba(213, 166, 107, 0.4);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.serenity-resource-value {
    color: rgb(241, 238, 232);
    -unity-font-style: bold;
}

.serenity-time-cluster {
    background-color: rgba(15, 21, 27, 0.58);
    padding-left: 5px;
    padding-right: 5px;
    margin-left: 5px;
    margin-right: 5px;
}

.serenity-resource-drawer {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 10px;
    background-color: rgba(20, 27, 33, 0.98);
    border-left-width: 2px;
    border-left-color: rgb(213, 166, 107);
}

.serenity-resource-line {
    flex-grow: 1;
    color: rgb(218, 222, 224);
    margin-left: 7px;
    white-space: normal;
}

.serenity-resident-strip {
    padding-left: 3px;
    padding-right: 3px;
    overflow: hidden;
}

.serenity-resident-card {
    width: 92px;
    height: 58px;
    min-height: 58px;
    margin-right: 4px;
    padding-left: 32px;
    padding-right: 4px;
    font-size: 10px;
    -unity-text-align: middle-left;
    white-space: normal;
    background-color: rgba(29, 36, 43, 0.92);
    background-size: 27px 27px;
    background-position: 3px 50%;
    background-repeat: no-repeat;
}

.serenity-resident-card.is-selected {
    background-color: rgba(66, 76, 85, 0.98);
    border-bottom-width: 2px;
    border-bottom-color: rgb(232, 197, 142);
}

.serenity-navigation-rail {
    background-color: rgba(20, 27, 33, 0.96);
    overflow: hidden;
}

.serenity-nav-toggle {
    min-height: 36px;
    font-size: 19px;
    background-color: rgba(51, 65, 75, 0.9);
}

.serenity-gameplay .serenity-nav-button {
    min-height: 44px;
    padding-left: 4px;
    padding-right: 4px;
    background-size: 31px 31px;
    background-position: 50% 50%;
    background-repeat: no-repeat;
    background-color: rgba(29, 36, 43, 0.76);
}

.serenity-gameplay .serenity-navigation-rail.is-expanded .serenity-nav-button {
    padding-left: 40px;
    background-size: 30px 30px;
    background-position: 5px 50%;
}

.serenity-gameplay .serenity-nav-button.is-selected {
    color: rgb(255, 250, 242);
    background-color: rgb(51, 65, 75);
    border-left-color: rgb(232, 197, 142);
}

.serenity-icon-button {
    min-width: 38px;
    min-height: 38px;
    background-size: 27px 27px;
    background-position: 50% 50%;
    background-repeat: no-repeat;
}

.serenity-compact-button {
    min-width: 30px;
    padding-left: 4px;
    padding-right: 4px;
}

.serenity-bottom-dock {
    background-color: rgba(20, 27, 33, 0.96);
    border-top-width: 2px;
    border-top-color: rgba(213, 166, 107, 0.72);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    padding-left: 7px;
    padding-right: 7px;
}

.serenity-build-category {
    width: 62px;
    height: 62px;
    margin-left: 3px;
    margin-right: 3px;
    background-size: 43px 43px;
    background-position: 50% 42%;
    background-repeat: no-repeat;
    background-color: rgba(41, 51, 61, 0.92);
}

.serenity-build-category:hover {
    background-color: rgb(63, 76, 86);
}

.serenity-main-panel.is-build-palette {
    background-color: rgba(20, 27, 33, 0.97);
    border-top-width: 2px;
    border-top-color: rgb(213, 166, 107);
}

.serenity-main-panel.is-build-palette .serenity-title,
.serenity-main-panel.is-build-palette .serenity-body {
    width: 100%;
}

.serenity-build-card {
    width: 260px;
    min-height: 172px;
    margin-left: 4px;
    margin-right: 4px;
    background-color: rgba(41, 51, 61, 0.91);
}

.serenity-inspector,
.serenity-notifications {
    background-color: rgba(20, 27, 33, 0.96);
}

.serenity-notification {
    min-height: 44px;
    -unity-text-align: middle-left;
    border-left-width: 4px;
}

.serenity-notification.is-info {
    border-left-color: rgb(101, 184, 154);
}

.serenity-notification.is-warning {
    border-left-color: rgb(228, 170, 96);
}

.serenity-notification.is-danger {
    border-left-color: rgb(207, 107, 105);
}

.serenity-placement-feedback {
    min-height: 38px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 8px;
    padding-bottom: 8px;
    color: rgb(245, 245, 242);
    background-color: rgba(20, 27, 33, 0.96);
    border-left-width: 4px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    white-space: normal;
}

.serenity-placement-feedback.is-free {
    border-left-color: rgb(72, 216, 143);
}

.serenity-placement-feedback.requires-clearance {
    border-left-color: rgb(236, 167, 64);
}

.serenity-placement-feedback.is-blocked {
    border-left-color: rgb(222, 82, 78);
}

.serenity-compact .serenity-resource-chip {
    min-width: 51px;
    padding-left: 2px;
    padding-right: 3px;
}

.serenity-compact .serenity-resource-chip .serenity-icon {
    width: 20px;
    height: 20px;
}

.serenity-compact .serenity-resident-card {
    width: 78px;
}

.serenity-gameplay .serenity-resident-card.serenity-icon-button {
    width: 102px; min-width: 102px; flex-shrink: 0;
    padding-left: 34px;
    background-size: 27px 27px;
    background-position: 4px 50%;
    -unity-text-align: middle-left;
}

.serenity-compact .serenity-resident-card.serenity-icon-button {
    width: 84px; min-width: 84px;
    padding-left: 29px;
    background-size: 23px 23px;
    background-position: 3px 50%;
}

/* UI02 final cascade: keep this block last. */
.serenity-root { color: rgb(238, 231, 216); }
.serenity-main-menu, .serenity-menu-atmosphere { background-color: rgb(13, 12, 10); }
.serenity-surface, .serenity-menu-shell,
.serenity-gameplay .serenity-surface, .serenity-gameplay .serenity-card,
.serenity-gameplay .serenity-button, .serenity-gameplay .serenity-foldout > .unity-foldout__toggle {
    color: rgb(238, 231, 216);
    background-color: rgba(23, 21, 17, 0.96);
    border-left-color: rgba(184, 154, 91, 0.46);
    border-right-color: rgba(184, 154, 91, 0.26);
    border-top-color: rgba(184, 154, 91, 0.26);
    border-bottom-color: rgba(184, 154, 91, 0.26);
}
.serenity-gameplay .serenity-surface-raised, .serenity-modal { background-color: rgba(33, 30, 24, 0.98); }
.serenity-gameplay .serenity-button:hover {
    color: rgb(238, 231, 216); background-color: rgb(48, 43, 34);
    border-left-color: rgb(210, 184, 117); border-right-color: rgb(210, 184, 117);
    border-top-color: rgb(210, 184, 117); border-bottom-color: rgb(210, 184, 117);
}
.serenity-gameplay .serenity-button-primary,
.serenity-gameplay .serenity-time-button.is-selected,
.serenity-gameplay #pause-button.is-selected { color: rgb(23, 19, 13); background-color: rgb(184, 154, 91); }
.serenity-title { color: rgb(210, 184, 117); }
.serenity-section-title, .serenity-body { color: rgb(238, 231, 216); }
.serenity-muted { color: rgb(184, 174, 155); }
.serenity-top-hud, .serenity-resource-drawer, .serenity-inspector, .serenity-notifications,
.serenity-main-panel.is-build-palette, .serenity-bottom-dock {
    background-color: rgba(23, 21, 17, 0.96); border-color: rgba(184, 154, 91, 0.56);
}
.serenity-resource-chip, .serenity-time-cluster, .serenity-resident-card,
.serenity-build-card, .serenity-build-category { background-color: rgba(42, 38, 30, 0.94); }
.serenity-icon, .serenity-icon-button { -unity-background-image-tint-color: rgb(210, 184, 117); }
.serenity-gameplay .serenity-bottom-navigation {
    background-color: rgba(15, 14, 12, 0.98);
    border-top-width: 1px; border-top-color: rgba(210, 184, 117, 0.72); overflow: hidden;
}
.serenity-bottom-navigation .unity-scroll-view__content-container {
    flex-direction: row; align-items: center; justify-content: center;
}
.serenity-gameplay .serenity-bottom-navigation .serenity-nav-button,
.serenity-gameplay .serenity-bottom-navigation.is-expanded .serenity-nav-button {
    width: 96px; min-width: 82px; height: 64px; min-height: 64px;
    margin-left: 2px; margin-right: 2px; padding-left: 4px; padding-right: 4px;
    padding-top: 31px; padding-bottom: 2px; font-size: 11px; white-space: normal;
    -unity-text-align: lower-center; background-size: 28px 28px; background-position: 50% 3px;
    border-left-width: 0; border-bottom-width: 2px; border-bottom-color: transparent;
    background-color: rgba(23, 21, 17, 0.96);
}
.serenity-gameplay .serenity-bottom-navigation .serenity-nav-button.is-selected {
    color: rgb(238, 231, 216); background-color: rgb(48, 43, 34);
    border-left-color: transparent; border-bottom-color: rgb(210, 184, 117);
}
.serenity-navigation-utility { background-color: rgb(42, 38, 30); }
.serenity-badge { background-color: rgba(42, 38, 30, 0.94); color: rgb(238, 231, 216); }

/* UI03 world HUD and stable selection surfaces. */
.serenity-settlement-identity {
    width: 178px; min-width: 150px; margin-right: 8px; padding-left: 8px; padding-right: 8px;
    justify-content: center; border-right-width: 1px; border-right-color: rgba(184, 154, 91, 0.32);
}
.serenity-settlement-name {
    color: rgb(238, 231, 216); font-size: 15px; -unity-font-style: bold; white-space: nowrap;
}
.serenity-settlement-status { color: rgb(184, 174, 155); font-size: 11px; white-space: nowrap; }
.serenity-settlement-status.is-warning { color: rgb(210, 184, 117); }
.serenity-settlement-status.is-danger { color: rgb(196, 121, 103); }
.serenity-attention-button {
    min-width: 92px; height: 42px; margin-left: 4px; margin-right: 4px; padding-left: 5px; padding-right: 5px;
    flex-direction: row; align-items: center; justify-content: center;
}
.serenity-attention-button .serenity-icon { width: 22px; height: 22px; margin-right: 3px; }
.serenity-command-ribbon {
    padding-left: 10px; padding-right: 10px; background-color: rgba(15, 14, 12, 0.98);
    border-top-width: 1px; border-left-width: 1px; border-right-width: 1px;
    border-top-color: rgba(210, 184, 117, 0.72); border-left-color: rgba(184, 154, 91, 0.36);
    border-right-color: rgba(184, 154, 91, 0.36); border-top-left-radius: 9px; border-top-right-radius: 9px;
}
.serenity-selection-summary { width: 205px; min-width: 150px; margin-right: 8px; }
.serenity-selection-summary-title {
    color: rgb(238, 231, 216); font-size: 14px; -unity-font-style: bold; white-space: nowrap;
}
.serenity-selection-queue-label { color: rgb(184, 174, 155); font-size: 11px; white-space: nowrap; }
.serenity-command-actions { flex-grow: 1; align-items: center; }
.serenity-command-actions .serenity-button { min-height: 42px; margin-left: 3px; margin-right: 3px; }
.serenity-command-status { display: none; }
.serenity-command-status .serenity-body { font-size: 11px; }
.serenity-command-status #main-menu-button { display: none; }
.serenity-inspector-header {
    margin-left: -10px; margin-right: -10px; margin-top: -8px; margin-bottom: 8px;
    padding-left: 14px; padding-right: 14px; padding-top: 11px; padding-bottom: 11px;
    background-color: rgba(15, 14, 12, 0.94); border-bottom-width: 1px;
    border-bottom-color: rgba(184, 154, 91, 0.42);
}
.serenity-inspector-kicker {
    color: rgb(184, 154, 91); font-size: 10px; -unity-font-style: bold; white-space: nowrap;
}
.serenity-inspector-title {
    color: rgb(238, 231, 216); font-size: 21px; -unity-font-style: bold; white-space: normal;
}
.serenity-inspector-now {
    margin-top: 7px; padding-left: 8px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px;
    color: rgb(238, 231, 216); background-color: rgba(42, 38, 30, 0.92); white-space: normal;
}
.serenity-queue-order {
    min-height: 28px; margin-top: 2px; margin-bottom: 2px; padding-left: 8px; padding-top: 5px;
    color: rgb(238, 231, 216); background-color: rgba(42, 38, 30, 0.72);
    border-left-width: 2px; border-left-color: rgb(184, 154, 91);
}
.serenity-compact .serenity-settlement-identity { width: 132px; min-width: 118px; }
.serenity-compact .serenity-settlement-status { display: none; }
.serenity-compact .serenity-settlement-name { font-size: 12px; }
.serenity-compact .serenity-selection-summary { width: 145px; min-width: 125px; }
.serenity-compact .serenity-command-actions .serenity-button { font-size: 11px; padding-left: 7px; padding-right: 7px; }
.serenity-compact .serenity-command-status { display: none; }

/* UI07 acceptance and accessibility polish. Keep this block last. */
.serenity-root .serenity-button {
    min-height: 40px;
}
.serenity-root .serenity-field,
.serenity-root .serenity-field .unity-base-text-field__input,
.serenity-root .serenity-field .unity-popup-field__input {
    min-height: 40px;
}
.serenity-root .serenity-button:focus,
.serenity-root .serenity-field:focus,
.serenity-root .serenity-field .unity-base-text-field__input:focus,
.serenity-root .serenity-field .unity-popup-field__input:focus {
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(238, 205, 132);
    border-right-color: rgb(238, 205, 132);
    border-top-color: rgb(238, 205, 132);
    border-bottom-color: rgb(238, 205, 132);
}
.serenity-root .serenity-button:disabled {
    opacity: 0.58;
}
.serenity-root .unity-scroller--vertical {
    width: 16px;
    min-width: 16px;
}
.serenity-root .unity-scroller--horizontal {
    height: 16px;
    min-height: 16px;
}
.serenity-campaign-outcome {
    background-color: rgba(23, 21, 17, 0.99);
    border-left-width: 4px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(184, 154, 91);
    border-right-color: rgba(210, 184, 117, 0.72);
    border-top-color: rgba(210, 184, 117, 0.72);
    border-bottom-color: rgba(210, 184, 117, 0.72);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}
#realm-route-actions .serenity-button {
    min-height: 40px;
    height: 40px;
}
#realm-route-facts .serenity-muted {
    font-size: 10px;
}
.serenity-compact .serenity-attention-button {
    min-width: 54px;
    width: 54px;
}
.serenity-compact .serenity-attention-button #alert-count {
    width: 20px;
    min-width: 20px;
    white-space: nowrap;
    font-size: 13px;
}
.serenity-compact .serenity-menu-editor .serenity-preview {
    height: 300px;
}
