/Assets/28102026/
/Assets/28102026.meta

# Temporary scenes emitted by editor tests must never enter the asset fingerprint.
/Assets/InitTestScene*.unity
/Assets/InitTestScene*.unity.meta
.env
.env.*
*.local.config
